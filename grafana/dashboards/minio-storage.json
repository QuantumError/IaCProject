{
  "title": "MinIO Storage Metrics",
  "uid": "minio-storage",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Cluster Usable Capacity Used",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "100 * (1 - (minio_cluster_capacity_usable_free_bytes / minio_cluster_capacity_usable_total_bytes))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Cluster Raw Capacity (Total vs Free)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "expr": "minio_cluster_capacity_raw_total_bytes",
          "legendFormat": "raw total",
          "refId": "A"
        },
        {
          "expr": "minio_cluster_capacity_raw_free_bytes",
          "legendFormat": "raw free",
          "refId": "B"
        }
      ]
    },
    {
      "id": 3,
      "title": "Bucket Storage Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (bucket) (minio_bucket_usage_total_bytes)",
          "legendFormat": "{{bucket}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "S3 Request Rate by Bucket",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (bucket) (rate(minio_bucket_requests_total{bucket=~\"terraform-state|my-sample-website|my-sample-website-2\"}[5m]))",
          "legendFormat": "{{bucket}}",
          "refId": "A"
        }
      ]
    }
  ]
}